# Paystack API Keys
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

# Frontend URL for callbacks
FRONTEND_URL=https://loc-safe.com

# Lambda Function URL (update after deployment)
LAMBDA_FUNCTION_URL=https://your-lambda-url.amazonaws.com/paystack

# Optional: Database connection for storing payment records
DATABASE_URL=mongodb://localhost:27017/locsafe

# Optional: Email service configuration
EMAIL_SERVICE_API_KEY=your_email_service_api_key
EMAIL_FROM=noreply@loc-safe.com

# Optional: SMS service configuration (for Kenya)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=LOCSAFE

# Environment
NODE_ENV=production